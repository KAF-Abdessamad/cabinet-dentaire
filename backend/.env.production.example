# DentistPro Production Environment Settings
# Duplicate this file as .env in production and fill in secret values.

APP_NAME="DentistPro"
APP_ENV=production
APP_KEY=  # Run 'php artisan key:generate' to populate in production
APP_DEBUG=false
APP_URL=https://cabinet.dentistpro.com

# Timezone settings (Morocco standard)
APP_TIMEZONE=Africa/Casablanca
APP_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=error

# Database Configuration (MySQL/MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cabinet_dentaire_prod
DB_USERNAME=dentistpro_user
DB_PASSWORD=secret_secure_password

# Session & Cache configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# CORS Stateful domains for Sanctum Authentication
SANCTUM_STATEFUL_DOMAINS=cabinet.dentistpro.com
FRONTEND_URL=https://cabinet.dentistpro.com

# Redis Config (Recommended if using large-scale caching)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production SMTP Mail Configurations
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@cabinet.dentistpro.com
MAIL_PASSWORD=mailgun_secret_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@dentistpro.com"
MAIL_FROM_NAME="DentistPro Cabinet"
